 "titulares": [
  {
   "t": "222.881 negocios de España pueden ser suplantados por correo hoy mismo",
   "d": "El 80,7 % de los que tienen correo propio no tiene la protección que lo impide (DMARC)."
  },
  {
   "t": "15.139 webs de negocios se quedan sin candado en los próximos 30 días",
   "d": "Su certificado caduca antes de un mes desde la medición; 568 de ellas, en menos de una semana."
  },
  {
   "t": "60.053 negocios siguen anunciando una web cuyo dominio ya no existe",
   "d": "Casi todos esos dominios se pueden registrar por unos 10 €: quien lo haga recibe los correos de ese negocio."
  },
  {
   "t": "Las farmacias, el sector más suplantable: 85,1 %",
   "d": "Sobre 2.631 con correo propio. El que mejor está, abogados, gestorías y seguros, sigue en el 75,9 %."
  },
  {
   "t": "Los bares y cafeterías: 39,5 % de webs que no abren",
   "d": "El sector con más webs caídas, de 12.855 revisadas."
  },
  {
   "t": "159 dominios tienen un SPF que autoriza a cualquiera a mandar en su nombre",
   "d": "Su registro termina en «+all» o «all»: no solo no protege, invita."
  },
  {
   "t": "11.796 negocios no tienen ni SPF ni DMARC",
   "d": "El 4,3 % de los que tienen correo propio: ninguna de las dos protecciones básicas."
  },
  {
   "t": "Castro-Urdiales: 40,2 % de webs que no abren, récord de España",
   "d": "Entre las 308 ciudades con 200 webs o más."
  },
  {
   "t": "Segovia, la provincia con más correo suplantable: 86,3 %",
   "d": "Y Soria, la que menos: 72,8 %."
  },
  {
   "t": "Con Webempresa, el 98,9 % de los dominios se puede suplantar",
   "d": "Con Raiola Networks, el 50,1 %. La protección la pone cada negocio, pero el proveedor pesa."
  },
  {
   "t": "311 webs de negocios responden «pago requerido»",
   "d": "El código 402, el que enseñan algunos proveedores cuando la cuenta está suspendida."
  },
  {
   "t": "33 negocios escribieron mal su protección del correo",
   "d": "Pusieron «quarentine», «rejet» o algo parecido en su DMARC. Un error de una letra que la deja sin efecto."
  }
